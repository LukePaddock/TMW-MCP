# Copy this file to .env and adjust for your environment.
# .env is gitignored — never commit real credentials.

# --- Database connection ---
TMW_DB_SERVER=your-sql-server
TMW_DB_DATABASE=your_database
TMW_DB_DRIVER=SQL Server Native Client 11.0

# --- Authentication ---
# Leave both blank to use Windows Authentication (Trusted_Connection=yes).
# Set both to use SQL Server authentication instead.
TMW_DB_USER=
TMW_DB_PASSWORD=

# --- Tuning ---
# Connection (login) timeout in seconds.
TMW_DB_TIMEOUT=30

# --- Driver encryption (needed in Docker, ignored on Windows) ---
# The Linux container uses "ODBC Driver 18 for SQL Server", which defaults to
# Encrypt=yes with full certificate validation. Against a SQL Server with a
# self-signed or AD-issued certificate that connection is refused. Set one of
# these. Both are appended to the connection string only when non-empty, so
# leaving them blank keeps the Windows Native Client 11 behaviour unchanged.
TMW_DB_ENCRYPT=
TMW_DB_TRUST_SERVER_CERTIFICATE=
# How far back truck_location searches for the latest check call.
TMW_CHECKCALL_LOOKBACK_DAYS=30
# Hard cap on rows returned by search_orders / summarize_orders.
TMW_MAX_SEARCH_ROWS=200

# --- Network transport ---
# Only used with: python tmw_mcp.py --transport http
# Bind address. 127.0.0.1 is local-only; use 0.0.0.0 to accept connections from
# other machines (or the Docker host running Nginx Proxy Manager).
TMW_MCP_HOST=127.0.0.1
TMW_MCP_PORT=8000

# Host / Origin allow-lists for DNS rebinding protection. REQUIRED in practice
# when TMW_MCP_HOST is not loopback: the SDK only auto-enables this protection
# for localhost, so binding 0.0.0.0 without these leaves it off. Set the
# hostname clients actually connect to — behind a reverse proxy that is the
# public name, not the bind address.
#
# Write the BARE hostname. A "host:*" entry matches only a host that has a
# port, and behind a proxy on 443 the forwarded Host header has none, so
# "host:*" on its own rejects every request with 421. config.py expands
# either spelling to both, but bare is the form to write.
TMW_MCP_ALLOWED_HOSTS=tmw-mcp.example.internal
TMW_MCP_ALLOWED_ORIGINS=https://tmw-mcp.example.internal

# --- API keys ---
# Comma-separated LABEL:SECRET pairs. One key per person, so a single tester can
# be revoked without rotating everyone and the log can name who called.
# Secrets must not contain a comma. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Startup FAILS if TMW_MCP_HOST is non-loopback and this is empty.
TMW_MCP_API_KEYS=alice:REPLACE_ME,bob:REPLACE_ME

# --- Client IP resolution and failed-auth logging ---
# IPs or CIDRs whose X-Real-IP / X-Forwarded-For headers are believed. A
# forwarded header is trusted ONLY when the connecting peer is in this list;
# otherwise the peer address is used and the headers ignored.
#
# X-Forwarded-For is attacker-controlled: nginx APPENDS to it, so a request
# sent with "X-Forwarded-For: 8.8.8.8" arrives as "8.8.8.8, <real client>".
# Reading the first entry would let anyone get an arbitrary IP banned, so the
# last entry is used, and X-Real-IP (which nginx overwrites) is preferred.
#
# Behind a proxy this MUST be set or the log records the proxy, not the client.
TMW_MCP_TRUSTED_PROXIES=

# Path for the failed-authentication log that fail2ban watches. Leave blank to
# disable. Rotates at 5 MB, three backups. See fail2ban/ for filter and jail.
TMW_MCP_AUTH_LOG=
